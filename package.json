{
	"dependencies": {
		"@sveltejs/adapter-cloudflare": "8.0.1",
		"@sveltejs/kit": "3.1.0",
		"svelte": "5.57.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.6",
		"knip": "6.43.0",
		"svelte-check": "4.7.7",
		"typescript": "5.9.3",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"wrangler": "4.155.0"
	},
	"engines": {
		"node": ">=22"
	},
	"name": "clicky-game",
	"packageManager": "bun@1.4.4",
	"private": true,
	"scripts": {
		"build": "vite build",
		"cf-typegen": "wrangler types",
		"deploy:dry": "bun run build && wrangler deploy --dry-run",
		"dev": "vite dev",
		"e2e": "playwright test",
		"format": "biome check --write .",
		"knip": "knip",
		"lint": "biome check .",
		"preview": "wrangler dev",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"version": "1.0.0"
}
